# Supabase — get these from your project dashboard at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LLM — Claude API (primary)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM — OpenAI fallback (optional)
OPENAI_API_KEY=your-openai-api-key-here

# Apify — Instagram scraping (weekly social_discovery + instagram_enrichment workflows)
APIFY_API_TOKEN=your-apify-token-here

# Serper.dev — Instagram handle discovery (https://serper.dev, free tier 2500 queries)
SERPER_API_KEY=your-serper-api-key-here

# DEPRECATED — Google Custom Search JSON API closed to new customers; replaced by Serper.dev
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
