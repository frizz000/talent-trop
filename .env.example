# Supabase — get these from your project dashboard at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LLM — Claude API (primary)
# Używany też przez moduł /search — ustaw jako env var w Vercel, nie tylko GitHub secret
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM — OpenAI fallback (optional)
OPENAI_API_KEY=your-openai-api-key-here

# Apify — Instagram scraping (weekly social_discovery + instagram_enrichment
# workflows + moduł /search) — ustaw też w env Vercela
APIFY_API_TOKEN=your-apify-token-here

# Serper.dev — Instagram handle discovery + moduł /search — ustaw też w env Vercela
# (https://serper.dev, free tier 2500 queries)
SERPER_API_KEY=your-serper-api-key-here

# Pipeline on/off switches — shared secret for GET /api/pipeline-status
# (GitHub Actions header x-pipeline-check-key). Same value must be set as a
# GitHub repo secret PIPELINE_CHECK_SECRET and a Vercel env var.
# Generate: openssl rand -hex 32
PIPELINE_CHECK_SECRET=your-pipeline-check-secret-here

# DEPRECATED — Google Custom Search JSON API closed to new customers; replaced by Serper.dev
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
