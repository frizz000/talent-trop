# Supabase — get these from your project dashboard at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LLM — Claude API (primary)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM — OpenAI fallback (optional)
OPENAI_API_KEY=your-openai-api-key-here

# Apify — Instagram scraping (weekly social_discovery workflow)
APIFY_API_TOKEN=your-apify-token-here

# Google Custom Search — Instagram handle discovery
GOOGLE_CSE_API_KEY=your-google-cse-api-key-here
GOOGLE_CSE_CX=your-custom-search-engine-id-here
